# ---- Server ----
PORT=8787
VITALIS_ENV=development

# Storage backend: "memory" (default, no external services needed) or "supabase"
STORE_BACKEND=memory

# Supabase (required only when STORE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers: "mock" (default, deterministic — no external calls) or "openai"
LLM_PROVIDER=mock
OCR_PROVIDER=mock

# OpenAI-compatible endpoint (works with OpenAI, OpenRouter, vLLM, Ollama, etc.)
# Recommended vision model for handwritten documents: gpt-4o / claude-sonnet / Qwen2.5-VL (self-hosted)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VITALIS_VISION_MODEL=gpt-4o
VITALIS_TEXT_MODEL=gpt-4o-mini

# Pipeline tuning
OCR_CONFIDENCE_ESCALATION_THRESHOLD=0.72
FIELD_CONFIDENCE_REVIEW_THRESHOLD=0.80
